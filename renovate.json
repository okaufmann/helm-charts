{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "timezone": "Europe/Zurich",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Chart.yaml appVersion from a # renovate comment",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\nappVersion:\\s+[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Ignore the deprecated Hetzner CSI chart",
      "matchFileNames": [
        "charts/hcloud-csi-driver/**"
      ],
      "enabled": false
    },
    {
      "description": "Bump the chart version when appVersion changes",
      "matchFileNames": [
        "charts/**"
      ],
      "bumpVersions": [
        {
          "name": "Helm chart version",
          "filePatterns": [
            "{{packageFileDir}}/Chart.yaml"
          ],
          "matchStrings": [
            "(?:^|\\n)version:\\s+\"(?<version>[^\"]+)\""
          ],
          "bumpType": "{{#if isPatch}}patch{{else}}minor{{/if}}"
        }
      ]
    }
  ]
}
